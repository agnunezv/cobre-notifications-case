POSTGRES_DB=cobre_notifications
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/cobre_notifications
DB_USER=replace_with_local_username
DB_PASSWORD=replace_with_local_password
NOTIFICATION_JSON_IMPORT_ENABLED=true
# Enable these values when Cobre provides the HTTPS endpoint used for the demo.
NOTIFICATION_SUBSCRIPTION_BOOTSTRAP_ENABLED=false
NOTIFICATION_SUBSCRIPTION_BOOTSTRAP_ID=DEMO_SUBSCRIPTION
NOTIFICATION_SUBSCRIPTION_BOOTSTRAP_CLIENT_ID=CLIENT002
NOTIFICATION_SUBSCRIPTION_BOOTSTRAP_ENDPOINT_URL=
NOTIFICATION_SUBSCRIPTION_BOOTSTRAP_EVENT_TYPES=credit_transfer
NOTIFICATION_WORKER_ENABLED=false
# Set distinct, high-entropy local values before calling protected endpoints.
NOTIFICATION_CLIENT_001_TOKEN=
NOTIFICATION_CLIENT_002_TOKEN=
NOTIFICATION_CLIENT_003_TOKEN=
