      "targets": [
        {
          "editorMode": "code",
          "expr": "ALERTS{alertstate=\"firing\",service=\"cobre-notification-platform\"}",
          "legendFormat": "{{severity}} · {{alertname}} · {{client_id}}",
          "range": true,
          "refId": "A"
        }
      ],
