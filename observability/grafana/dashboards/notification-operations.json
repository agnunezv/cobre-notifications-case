        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (client_id, http_status_class) (rate(cobre_notifications_delivery_attempts_total{client_id!=\"\",client_id=~\"$client_id\",event_type=~\"$event_type\"}[$__rate_interval]))",
          "legendFormat": "{{client_id}} · {{http_status_class}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP outcome class by client",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
