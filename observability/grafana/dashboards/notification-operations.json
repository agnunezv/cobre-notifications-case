  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Prometheus can scrape every configured application target. DOWN means delivery, self-service APIs, and event investigation may be unavailable; use the runtime-health dashboard to identify the affected component.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(up{job=\"cobre-notification-platform\"})",
          "instant": true,
          "legendFormat": "Availability",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "App availability",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Events eligible for delivery right now. A count that grows while the worker is enabled means arrivals are outpacing completions or processing has stalled; correlate it with oldest-event age and worker throughput.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(cobre_notifications_delivery_backlog_due_events)",
          "instant": false,
          "legendFormat": "Due events",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Due backlog",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Waiting time of the oldest event currently due. A rising age indicates delayed progress even when backlog volume is small; investigate worker health, subscription configuration, and recurring delivery failures.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(cobre_notifications_delivery_backlog_oldest_age_seconds)",
          "instant": false,
          "legendFormat": "Oldest due event",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Oldest due age",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Number of notification-platform alerts firing now. Use the alert timeline to identify the rule and affected client, then correlate it with failure cause, latency, backlog, or runtime health.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(ALERTS{alertstate=\"firing\",service=\"cobre-notification-platform\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Firing alerts",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Firing alerts",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (result) (rate(cobre_notifications_delivery_attempts_total{client_id!=\"\",client_id=~\"$client_id\",event_type=~\"$event_type\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Webhook attempt throughput by result for the selected clients and event types. Success traffic is expected; a retryable or permanent-failure spike should be localized with the client, failure-cause, and HTTP-outcome panels.",
      "title": "Selected-client webhook attempt rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, client_id) (rate(cobre_notifications_delivery_attempt_duration_seconds_bucket{client_id!=\"\",client_id=~\"$client_id\",event_type=~\"$event_type\"}[$__rate_interval])))",
          "legendFormat": "{{client_id}} p95",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "p95 webhook latency by client for the selected event types. One slow client usually points to its endpoint or network path; simultaneous increases across clients suggest shared outbound or platform pressure.",
      "title": "Selected-client webhook latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Non-successful webhook throughput grouped by client. Start here when a client reports degraded delivery, but confirm volume and duration before reacting to a single low-traffic failure.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (client_id) (rate(cobre_notifications_delivery_attempts_total{client_id!=\"\",client_id=~\"$client_id\",event_type=~\"$event_type\",result!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{client_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Failure rate by client",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Bounded causes direct the investigation: timeout or connectivity points to the client/network path, TLS to certificate validation, HTTP response to client behavior, and local HTTP-client failures to this platform.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (client_id, failure_category) (rate(cobre_notifications_delivery_attempts_total{client_id!=\"\",client_id=~\"$client_id\",event_type=~\"$event_type\",result!=\"success\",failure_category!=\"none\"}[$__rate_interval]))",
          "legendFormat": "{{client_id}} · {{failure_category}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Failure causes by client",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "HTTP classes summarize client responses: 2xx is accepted, 4xx suggests contract or request rejection, and 5xx indicates client-side unavailability. Transport failures appear as none; raw status codes stay in attempt history.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
