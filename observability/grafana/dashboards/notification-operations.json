    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "p95 worker-cycle duration by outcome. Compare it with the poll interval and lease duration; sustained growth alongside webhook latency or backlog suggests capacity pressure, while failures require worker investigation.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
