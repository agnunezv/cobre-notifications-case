    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Business work performed by the worker: claims, completions, recovered leases, skipped preparation, stale completion, and processing failures. It does not represent empty successful polls; worker liveness belongs to runtime health.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
